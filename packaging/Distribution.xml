<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>PDF Slim</title>
    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>

    <pkg-ref id="rs.rbt.pdfslim"/>
    <choices-outline>
        <line choice="default">
            <line choice="rs.rbt.pdfslim"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="rs.rbt.pdfslim" visible="false">
        <pkg-ref id="rs.rbt.pdfslim"/>
    </choice>
    <pkg-ref id="rs.rbt.pdfslim">pdfslim-component.pkg</pkg-ref>
</installer-gui-script>
